extends ../layout/index

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text.text-center.text-blue-600 Bienes
            span.font-normal.text.text-black Raíces
        if title
            h2.text-center.text-2xl.font-normal.text-black= title

    .mt-8.mx-auto.max-w-xl
        if msg
            .alerta.relative.bg-white.text-gray-900.text-center.p-6.rounded-lg.shadow-lg.border.border-gray-200
                p.text-xl.font-bold= msg
                if buttonVisible
                    a(class="w-full inline-block bg-gray-300 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase" href=buttonLink)= buttonText

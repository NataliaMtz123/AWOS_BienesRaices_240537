extends ../layout/index

block contenido
  .py-10
    h1.text-4xl.my-10.font-extrabold.text-center.text-pink-600 Bienes
      span.font-normal.text-black Raíces
    h2.text-center.text-2xl.font-normal.text-black Desbloquear cuenta

    if errores
      .max-w-md.mx-auto.my-10
        each error in errores
          .bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded
            span.block= error.msg

    if exito
      .max-w-md.mx-auto.my-10
        .bg-green-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded
          span.block= exito

    .mt-8.mx-auto.max-w-xl
      .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
        form(method="POST" action="/auth/desbloquear")
          if csrfToken
            input(type="hidden" name="_csrf" value=csrfToken)

          div.px-5.mb-4
            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="email") Correo electrónico:
            input#email.w-full.border.border-gray-300.px-3.py-2.rounded-xl(
              type="email"
              name="email"
              required
              placeholder="Ingresa tu correo registrado"
              value=email
            )

          div.px-5.mb-4
            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="codigoDesbloqueo") Código de desbloqueo:
            input#codigoDesbloqueo.w-full.border.border-gray-300.px-3.py-2.rounded-xl(
              type="text"
              name="codigoDesbloqueo"
              required
              placeholder="Ingresa el código de 6 dígitos recibido por correo"
              value=codigoUrl
            )

          div.flex.justify-center.py-6
            input(
              class="w-3/4 bg-gray-300 text-pink-600 hover:bg-pink-600 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase"
              type="submit"
              value="Desbloquear cuenta"
            )

          div.text-center.mt-4
            a.text-pink-600.hover.text-pink-700.text-sm(href="/auth/login") Volver al inicio de sesion
extends ../layout/index

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center.text-blue-600 Bienes
            span.font-normal.text-black Raíces
        h2.text-center.text-2xl.font-normal.text-black= pagina

        if errores 
            .max-w-md.mx-auto.my-6
                each error in errores
                    .bg-red-50.border-l-4.border-red-500.text-red-700.p-4.mb-3.shadow-md.rounded-r-xl.relative.flex.items-center.justify-between(role="alert")
                        div.flex.items-center
                            svg.w-5.h-5.mr-2(fill="currentColor" viewBox="0 0 20 20")
                                path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
                            p.text-sm.font-bold= error.msg
                        button(class="text-red-500 hover:text-red-800 font-bold" type="button" onclick="this.parentElement.remove()") ✕

        .mt-8.mx-auto.max-w-xl
            .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
                form.space-y-5(method="POST" action="/auth/recuperarPassword" noValidate)
                    
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="emailUsuario") Email de Registro:
                        
                        input#emailUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(
                            placeholder="Tu email de registro"
                            name="emailUsuario"
                            type="email"
                            required
                        )
                    
                    input(
                        class="w-full bg-gray-300 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 cursor-pointer rounded-full shadow-lg uppercase transition-colors"
                        type="submit"
                        value="Enviar Correo de Recuperación"
                    )

                    div.flex.items-center.justify-between.mt-5
                        a(class="text-gray-500 text-sm hover:underline transition decoration-blue-600 decoration-2" href="/auth/registro") ¿No tienes cuenta? Regístrate
                        a(class="text-gray-500 text-sm hover:underline transition decoration-blue-600 decoration-2" href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión

    footer.mt-16.border-t.pt-6.pb-8.text-center.text-gray-500.text-sm
        p © #{new Date().getFullYear()} Bienes Raíces. Todos los derechos reservados.
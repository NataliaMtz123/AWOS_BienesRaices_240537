extends ../layout/index

block contenido
    .max-w-md.mx-auto.mt-10.bg-white.shadow-md.rounded-lg.p-6

        h1.text-2xl.font-bold.text-center.mb-4= pagina

        if email
            p.text-center.text-gray-600.mb-4 Cuenta: #{email}

        if error
            p.bg-red-100.text-red-700.p-2.rounded.mb-4.text-center #{error}

        form(method="POST" action=`/auth/crearPassword/${id}`)

            input(type="hidden" name="_csrf" value=csrfToken)

            .mb-4
                label.block.text-gray-700(for="password") Nueva contraseña
                input#password.w-full.border.p-2.rounded(
                    type="password"
                    name="password"
                    placeholder="Ingresa tu nueva contraseña"
                    required
                )

            .mb-4
                label.block.text-gray-700(for="password2") Confirmar contraseña
                input#password2.w-full.border.p-2.rounded(
                    type="password"
                    name="password2"
                    placeholder="Confirma tu contraseña"
                    required
                )

            button.w-full.bg-blue-600.text-white.p-2.rounded.hover.bg-blue-700(
                type="submit"   
            ) Actualizar contraseña
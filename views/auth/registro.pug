extends ../layout/index

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text.text-center.text-blue-600 Bienes
            span.font-normal.text.text-black Raíces
        h2.text-center.text-2xl.font-normal.text-black= pagina

        .mt-8.mx-auto.max-w-xl
            .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
                form.space-y-5(method="POST" action="/auth/registro")
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="nombreUsuario") Tu nombre completo: 
                        input#nombreUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="p.e: Ingrid Natalia Martinez Carrasco" name="nombreUsuario" type="text")
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="correoUsuario") Email de Registro: 
                        input#correoUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="p.e: ingrid@bienesraices.com" name="correoUsuario" type="email")
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="contraseUsuario") Ingresa tu contraseña: 
                        input#contraseUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="Por lo menos 8 caracteres" name="contraseUsuario" type="password")
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="confirmarContraseUsuario") Confirma tu contraseña: 
                        input#confirmarContraseUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="Repite tu contraseña" name="confirmarContraseUsuario" type="password")
                    input(class="w-full bg-gray-300 text-blue-600 hover:bg-blue-600 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase" type="submit" value="Registrar Usuario")

                    div.flex.items-center.justify-between 
                        a(class="text-gray-500 text-sm hover:decoration-blue-600 hover:underline transition decoration-2" href="/auth/login") ¿Ya tienes una cuenta? Inicia sesion
                        a(class="text-gray-500 text-sm  hover:decoration-blue-600 hover:underline transition decoration-2" href="/recuperar") ¿Olvidaste tu contraseña? Recuperarla

    footer.mt-16.border-t.pt-6.pb-8.text-center.text-gray-500.text-sm
        p © #{new Date().getFullYear()} Bienes Raíces. Todos los derechos reservados.
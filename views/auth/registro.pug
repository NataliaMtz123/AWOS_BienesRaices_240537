extends ../layout/index 

block contenido
    .py-1
        h1.text-4xl.my-10.font-extrabold.text-center.text-pink-600 Bienes
            span.font-normal.text-black Raíces
        h2.text-center.text-2xl.font-normal.text-black Por favor ingresa cuidadosamente tus datos

        // Contenedor para errores del servidor (ARRIBA DEL FORMULARIO)
        if errores 
            .max-w-md.mx-auto.my-10
                each error in errores 
                    .mensaje-error.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded.relative.overflow-hidden
                        span.block.z-10.relative= error.msg
                        .barra-progreso.absolute.bottom-0.left-0.h-1.bg-white(style="width: 100%; animation: progreso 5s linear forwards;")

        // Contenedor para errores de validación del cliente (ARRIBA DEL FORMULARIO)
        #errores-cliente.max-w-md.mx-auto.my-10(style="display: none;")

        .mt-8.mx-auto.max-w-xl
            .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
                form.space-y-5(method="POST" action="/auth/registro" novalidate)
                    input(type="hidden" name="_csrf" value=csrfToken)
                    
                    div.px-5 
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="nombreUsuario") nombre completo:
                        input#nombreUsuario(type="text" class="hover:inset-shadow-sm focus:inset-shadow-xl focus:inset-shadow-pink-400 focus:outline-none" placeholder="p.e.: Ingrid Natalia Martinez Carrasco" name="nombreUsuario" value= usuario ? usuario.nombreUsuario: '').w-full.hover.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400
                    
                    div.px-5 
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="emailUsuario") correo electrónico:
                        input#emailUsuario(type="email" class="hover:inset-shadow-sm focus:inset-shadow-xl focus:inset-shadow-pink-400 focus:outline-none" placeholder="p.e.: correo@dominio.com" name="emailUsuario" value= usuario ? usuario.emailUsuario: '').w-full.hover.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400
                    
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="passwordUsuario") Contraseña:
                        input#passwordUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder= "Por los menos 8 carácteres" name="passwordUsuario" type="password" class="hover:inset-shadow-sm focus:inset-shadow-md focus:inset-shadow-pink-400/50 focus:outline-none")

                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="confirmacionUsuario") Confirmación de Contraseña:
                        input#confirmacionUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder= "Repite la contraseña anterior" name="confirmacionUsuario" type="password" class="hover:inset-shadow-sm focus:inset-shadow-md focus:inset-shadow-pink-400/50 focus:outline-none")
                    
                    // ===== CONTINUAR CON =====
                    div.flex.items-center.my-6
                        div.flex-grow.border-t.border-gray-300
                        span.mx-4.text-gray-400.text-sm Or continue with
                        div.flex-grow.border-t.border-gray-300

                    // ===== BOTONES GOOGLE Y FACEBOOK =====
                    div.grid.grid-cols-2.gap-4.px-5.pb-4
                        a(href="/auth/google" class="flex justify-center items-center gap-2 border border-gray-300 rounded-lg py-2 hover:bg-gray-100 transition")
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20")
                                path(fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.9 32.6 29.4 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C33.7 6.1 29.1 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.3-.4-3.5z")
                                path(fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3 0 5.7 1.1 7.8 2.9l5.7-5.7C33.7 6.1 29.1 4 24 4 16.3 4 9.7 8.3 6.3 14.7z")
                                path(fill="#4CAF50" d="M24 44c5.3 0 10.1-2 13.6-5.2l-6.3-5.2C29.2 35.6 26.7 36 24 36c-5.4 0-9.9-3.4-11.5-8.2l-6.5 5C9.4 39.5 16.1 44 24 44z")
                                path(fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.1-3.1 5.4-5.9 6.8l6.3 5.2C39.5 36.5 44 30.8 44 24c0-1.3-.1-2.3-.4-3.5z")
                            span.text-sm.font-medium Google

                        a(href="/auth/facebook" class="flex justify-center items-center gap-2 border border-gray-300 rounded-lg py-2 hover:bg-gray-100 transition")
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" fill="#1877F2")
                                path(d="M22.675 0h-21.35C.595 0 0 .595 0 1.326v21.348C0 23.406.595 24 1.326 24H12.82v-9.294H9.692V11.08h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.796.715-1.796 1.764v2.313h3.587l-.467 3.626h-3.12V24h6.116C23.405 24 24 23.406 24 22.674V1.326C24 .595 23.405 0 22.675 0z")
                            span.text-sm.font-medium Facebook

                    div.flex.justify-center.py-6
                        input(class="w-3/4 bg-gray-300 text-pink-600 hover:bg-pink-600 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase transition-all.duration-200" type="submit" value="Registrar Usuario")

                    div.flex.items-center.justify-between.pt-3
                        a(class="text-gray-500 text-sm hover:decoration-pink-600 hover:underline transition decoration-2" href="/auth/login") ¿Ya tienes cuenta? Inicia Sesión
                        a(class="text-gray-500 text-sm hover:decoration-pink-600 hover:underline transition decoration-2" href="/auth/recuperarPassword") ¿Olvidaste tu contraseña? Recuperala

    style.
        @keyframes progreso {
            from { width: 100%; }
            to { width: 0%; }
        }
        
        .mensaje-error {
            animation: aparecer 0.3s ease-out;
            position: relative;
        }
        
        @keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes desaparecer {
            from { 
                opacity: 1; 
                transform: translateY(0); 
            }
            to { 
                opacity: 0; 
                transform: translateY(-10px); 
            }
        }

    script.
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-ocultar errores del servidor
            const mensajesError = document.querySelectorAll('.mensaje-error');
            mensajesError.forEach(mensaje => {
                setTimeout(() => {
                    mensaje.style.animation = 'desaparecer 0.3s ease-out forwards';
                    setTimeout(() => {
                        mensaje.remove();
                    }, 300);
                }, 5000);
            });

            // Validación del formulario
            document.querySelector('form').addEventListener('submit', function(e) {
                e.preventDefault();
                
                const nombre = document.getElementById('nombreUsuario').value.trim();
                const email = document.getElementById('emailUsuario').value.trim();
                const password = document.getElementById('passwordUsuario').value;
                const confirmPassword = document.getElementById('confirmacionUsuario').value;
                
                const errores = [];
                
                // Validar nombre
                if (!nombre) {
                    errores.push('EL NOMBRE DE LA PERSONA NO PUEDE SER VACÍO');
                }
                
                // Validar email
                if (!email) {
                    errores.push('EL CORREO ELECTRÓNICO NO PUEDE SER VACÍO');
                } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                    errores.push('EL CORREO ELECTRÓNICO NO TIENE UN FORMATO ADECUADO');
                }
                
                // Validar contraseña
                if (!password) {
                    errores.push('LA CONTRASEÑA PARECE ESTAR VACÍA');
                } else if (password.length < 8 || password.length > 30) {
                    errores.push('LA LONGITUD DE LA CONTRASEÑA DEBE SER ENTRE 8 Y 30 CARACTÉRES');
                }
                
                // Validar confirmación
                if (password !== confirmPassword) {
                    errores.push('LAS CONTRASEÑAS NO COINCIDEN');
                }
                
                const contenedorErrores = document.getElementById('errores-cliente');
                contenedorErrores.innerHTML = '';
                contenedorErrores.style.display = 'none';
                
                if (errores.length > 0) {
                    contenedorErrores.style.display = 'block';
                    
                    errores.forEach(error => {
                        const divError = document.createElement('div');
                        divError.className = 'mensaje-error bg-red-600 text-white uppercase text-xs text-center p-2 mb-1 font-bold rounded relative overflow-hidden';
                        divError.innerHTML = `
                            <span class="block z-10 relative">${error}</span>
                            <div class="barra-progreso absolute bottom-0 left-0 h-1 bg-black" style="width: 100%; animation: progreso 5s linear forwards;"></div>
                        `;
                        contenedorErrores.appendChild(divError);
                        
                        // Auto-ocultar después de 5 segundos
                        setTimeout(() => {
                            divError.style.animation = 'desaparecer 0.3s ease-out forwards';
                            setTimeout(() => {
                                if (divError.parentNode) {
                                    divError.remove();
                                    if (contenedorErrores.children.length === 0) {
                                        contenedorErrores.style.display = 'none';
                                    }
                                }
                            }, 300);
                        }, 5000);
                    });
                    
                    // Scroll suave hacia los errores
                    contenedorErrores.scrollIntoView({ behavior: 'smooth', block: 'start' });
                } else {
                    this.submit();
                }
            });
        });
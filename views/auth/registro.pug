extends ../layout/index

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text.text-center.text-blue-600 Bienes
            span.font-normal.text.text-black Raíces
        h2.text-center.text-2xl.font-normal.text-black= pagina

         if errores 
            .max-w-md.mx-auto.my-6
                each error in errores
                    .bg-red-50.border-l-4.border-red-500.text-red-700.p-4.mb-3.shadow-md.rounded-r-xl.relative.flex.items-center.justify-between(role="alert")
                        div.flex.items-center
                            svg.w-5.h-5.mr-2(fill="currentColor" viewBox="0 0 20 20")
                                path(fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd")
                            p.text-sm.font-bold= error.msg
                        //- Solución: Definimos la clase hover dentro de los paréntesis
                        button(class="text-red-500 hover:text-red-800 font-bold" type="button" onclick="this.parentElement.remove()") ✕

        .mt-8.mx-auto.max-w-xl
            .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
                form.space-y-5(method="POST" action="/auth/registro" noValidate)
                    input(type="hidden" name="_csrf" value=csrfToken)
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="nombreUsuario") Tu nombre completo: 
                        input#nombreUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="p.e: Ingrid Natalia Martinez Carrasco", name="nombreUsuario", value=usuario ? usuario.nombreUsuario:'',  type="text")
                    
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="correoUsuario") Email de Registro: 
                        input#correoUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(placeholder="p.e: ingrid@bienesraices.com", name="correoUsuario", value=usuario ? usuario.correoUsuario:'',  type="email")
                    
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="contraseUsuario") Ingresa tu contraseña: 
                        .relative
                            input#contraseUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400.pr-10(placeholder="Por lo menos 8 caracteres", name="contraseUsuario", type="password")
                            button#togglePassword1.absolute.inset-y-0.right-0.pr-3.flex.items-center.text-gray-600.hover.text-blue-600(type="button")
                                svg#eyeIcon1.w-5.h-5(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                    
                    div.px-5
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="confirmarContraseUsuario") Confirma tu contraseña: 
                        .relative
                            input#confirmarContraseUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400.pr-10(placeholder="Repite tu contraseña", name="confirmarContraseUsuario", type="password")
                            button#togglePassword2.absolute.inset-y-0.right-0.pr-3.flex.items-center.text-gray-600.hover.text-blue-600(type="button")
                                svg#eyeIcon2.w-5.h-5(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z")
                                    path(stroke-linecap="round", stroke-linejoin="round", d="M15 12a3 3 0 11-6 0 3 3 0 016 0z")
                    
                    input.w-full.bg-gray-300.text-blue-600.hover-bg-blue-600.hover-text-white.font-bold.py-3.cursor-pointer.rounded-4xl.shadow-lg.uppercase(type="submit", value="Registrar Usuario")

                    //- Separador "OR"
                    .flex.items-center.justify-between.mt-4
                        hr.w-full.border-gray-300
                        span.px-3.text-gray-400.text-sm.font-light OR
                        hr.w-full.border-gray-300

                    //- 🟢 BOTONES FUNCIONALES DE GOOGLE Y GITHUB 🟢
                    .flex.flex-col.gap-3.mt-4
                        //- Botón de Google (AHORA ES UN LINK FUNCIONAL)
                        a.w-full.bg-white.border.border-gray-300.text-gray-700.font-medium.py-2.px-4.rounded-lg.shadow-sm.hover-bg-gray-50.transition.flex.items-center.justify-center.gap-3(href="/auth/google")
                            svg.w-5.h-5(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 48 48")
                                path(fill="#FFC107", d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z")
                                path(fill="#FF3D00", d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z")
                                path(fill="#4CAF50", d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z")
                                path(fill="#1976D2", d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z")
                            | Continuar con Google

                        //- Botón de GitHub (AHORA ES UN LINK FUNCIONAL)
                        a.w-full.bg-white.border.border-gray-300.text-gray-700.font-medium.py-2.px-4.rounded-lg.shadow-sm.hover-bg-gray-50.transition.flex.items-center.justify-center.gap-3(href="/auth/github")
                            svg.w-5.h-5(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="currentColor")
                                path(d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z")
                            | Continuar con GitHub

                    div.flex.items-center.justify-between.mt-6
                        a.text-gray-500.text-sm.hover-decoration-blue-600.hover-underline.transition.decoration-2(href="/auth/login") ¿Ya tienes una cuenta? Inicia sesion
                        a.text-gray-500.text-sm.hover-decoration-blue-600.hover-underline.transition.decoration-2(href="/auth/recuperarPassword") ¿Olvidaste tu contraseña? Recuperarla

    script.
        document.addEventListener('DOMContentLoaded', function() {
            // Función para el toggle de contraseña
            function togglePassword(buttonId, inputId, iconId) {
                const button = document.getElementById(buttonId);
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                
                if (button && input && icon) {
                    button.addEventListener('click', function() {
                        const type = input.type === 'password' ? 'text' : 'password';
                        input.type = type;
                        
                        // Cambiar el icono
                        if (type === 'password') {
                            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />';
                        } else {
                            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />';
                        }
                    });
                }
            }
            
            // Inicializar los toggles
            togglePassword('togglePassword1', 'contraseUsuario', 'eyeIcon1');
            togglePassword('togglePassword2', 'confirmarContraseUsuario', 'eyeIcon2');
        });

    footer.mt-16.border-t.pt-6.pb-8.text-center.text-gray-500.text-sm
        p © #{new Date().getFullYear()} Bienes Raíces. Todos los derechos reservados.
extends ../layout/index 

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center.text-pink-600 Bienes
            span.font-normal.text-black Raíces
        h2.text-center.text-2xl.font-normal.text-black Ingresa los datos de tu cuenta

        if errores 
            .max-w-md.mx-auto.my-10
                each error in errores 
                    .mensaje-error.bg-red-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded.relative.overflow-hidden
                        span.block.z-10.relative= error.msg
                        .barra-progreso.absolute.bottom-0.left-0.h-1.bg-white(style="width: 100%; animation: progreso 5s linear forwards;")

        if exito
            .max-w-md.mx-auto.my-10
                .mensaje-exito.bg-green-600.text-white.uppercase.text-xs.text-center.p-2.mb-1.font-bold.rounded
                    span.block= exito

        #errores-cliente.max-w-md.mx-auto.my-10(style="display: none;")

        .mt-8.mx-auto.max-w-xl
            .bg-white.py-8.px-4.shadow-2xl.rounded-2xl
                form.space-y-5(method="POST" action="/auth/login" noValidate)
                    input(type="hidden" name="_csrf" value=csrfToken)

                    div.px-5 
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="emailUsuario") correo electrónico:
                        input#emailUsuario(type="email",name="emailUsuario",value=usuario ? usuario.emailUsuario : "",placeholder="p.e.: correo@dominio.com").w-full.border.border-gray-300.px-3.py-2.rounded-xl
                    
                    // ===== PASSWORD CON OJITO =====
                    div.px-5.relative
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="passwordUsuario") Contraseña:
                        input#passwordUsuario.w-full.border.border-gray-300.px-3.py-2.rounded-xl.placeholder-gray-400(
                            placeholder="Por los menos 8 carácteres"
                            name="passwordUsuario"
                            type="password"
                            class="hover:inset-shadow-sm focus:inset-shadow-md focus:inset-shadow-pink-400/50 focus:outline-none")
                        span#togglePassword.absolute.right-8.top-10.cursor-pointer.text-gray-500 👁️

                    div.flex.justify-center.py-6
                        input(class="w-3/4 bg-gray-300 text-pink-600 hover:bg-pink-600 hover:text-white font-bold py-3 cursor-pointer rounded-4xl shadow-lg uppercase transition-all.duration-200" type="submit" value="Iniciar Sesión")

                    div.flex.items-center.justify-between
                        a(class="text-gray-500 text-sm hover:decoration-pink-600 hover:underline transition decoration-2" href="/auth/registro") ¿No tienes cuenta? Registrate
                        a(class="text-gray-500 text-sm hover:decoration-pink-600 hover:underline transition decoration-2" href="/auth/recuperarPassword") ¿Olvidaste tu contraseña? Recuperala

                    // Bloqueo de cuenta - Mensaje y botón para reenviar código
                    if cuentaBloqueada
                        .mt-4.text-center.bg-yellow-50.p-4.rounded-lg
                            p.text-gray-700.mb-2 ¿No recibiste el código de desbloqueo?
                            button#reenviarCodigo.text-pink-600.hover.text-pink-700.text-sm.font-bold(type="button")
                                | 📧 Reenviar código de desbloqueo
                            input(type="hidden" id="emailBloqueado" value=emailBloqueado || '')

    style.
        @keyframes progreso {
            from { width: 100%; }
            to { width: 0%; }
        }
        
        @keyframes desaparecer {
            from { 
                opacity: 1; 
                transform: translateY(0); 
            }
            to { 
                opacity: 0; 
                transform: translateY(-10px); 
            }
        }
        
        @keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .mensaje-error {
            animation: aparecer 0.3s ease-out;
            position: relative;
        }
        
        .mensaje-exito {
            animation: aparecer 0.3s ease-out;
        }

    script.
        document.addEventListener('DOMContentLoaded', function() {
            // 👁️ TOGGLE PASSWORD
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('passwordUsuario');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', () => {
                    const type = passwordInput.type === 'password' ? 'text' : 'password';
                    passwordInput.type = type;
                    togglePassword.textContent = type === 'password' ? '👁️' : '🙈';
                });
            }

            // Auto-ocultar errores del servidor
            const mensajesError = document.querySelectorAll('.mensaje-error');
            mensajesError.forEach(mensaje => {
                setTimeout(() => {
                    mensaje.style.animation = 'desaparecer 0.3s ease-out forwards';
                    setTimeout(() => {
                        if (mensaje.parentNode) mensaje.remove();
                    }, 300);
                }, 5000);
            });

            // Auto-ocultar mensajes de éxito
            const mensajesExito = document.querySelectorAll('.mensaje-exito');
            mensajesExito.forEach(mensaje => {
                setTimeout(() => {
                    mensaje.style.animation = 'desaparecer 0.3s ease-out forwards';
                    setTimeout(() => {
                        if (mensaje.parentNode) mensaje.remove();
                    }, 300);
                }, 5000);
            });

            // Validación del formulario
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    const email = document.getElementById('emailUsuario').value.trim();
                    const password = document.getElementById('passwordUsuario').value;

                    const errores = [];

                    if (!email) {
                        errores.push('EL CORREO NO PUEDE ESTAR VACÍO');
                    }

                    if (!password) {
                        errores.push('LA CONTRASEÑA NO PUEDE ESTAR VACÍA');
                    }
                    
                    const contenedorErrores = document.getElementById('errores-cliente');
                    contenedorErrores.innerHTML = '';
                    contenedorErrores.style.display = 'none';
                    
                    if (errores.length > 0) {
                        contenedorErrores.style.display = 'block';
                        
                        errores.forEach(error => {
                            const divError = document.createElement('div');
                            divError.className = 'mensaje-error bg-red-600 text-white uppercase text-xs text-center p-2 mb-1 font-bold rounded relative overflow-hidden';
                            divError.innerHTML = `
                                <span class="block z-10 relative">${error}</span>
                                <div class="barra-progreso absolute bottom-0 left-0 h-1 bg-white" style="width: 100%; animation: progreso 5s linear forwards;"></div>
                            `;
                            contenedorErrores.appendChild(divError);
                            
                            setTimeout(() => {
                                divError.style.animation = 'desaparecer 0.3s ease-out forwards';
                                setTimeout(() => {
                                    if (divError.parentNode) {
                                        divError.remove();
                                        if (contenedorErrores.children.length === 0) {
                                            contenedorErrores.style.display = 'none';
                                        }
                                    }
                                }, 300);
                            }, 5000);
                        });
                        
                        contenedorErrores.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } else {
                        this.submit();
                    }
                });
            }

            // Reenviar código de desbloqueo
            const reenviarBtn = document.getElementById('reenviarCodigo');
            if (reenviarBtn) {
                reenviarBtn.addEventListener('click', async function() {
                    const email = document.getElementById('emailBloqueado').value;
                    
                    if (!email) {
                        alert('❌ Por favor ingresa tu correo electrónico');
                        return;
                    }
                    
                    const boton = this;
                    const textoOriginal = boton.innerHTML;
                    boton.innerHTML = '⏳ Enviando...';
                    boton.disabled = true;
                    
                    try {
                        const response = await fetch('/auth/reenviar-codigo', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ email })
                        });
                        
                        const data = await response.json();
                        
                        if (response.ok) {
                            alert('✅ ' + data.mensaje);
                            setTimeout(() => {
                                window.location.href = '/auth/desbloquear';
                            }, 2000);
                        } else {
                            alert('❌ ' + (data.error || 'Error al reenviar el código'));
                            boton.innerHTML = textoOriginal;
                            boton.disabled = false;
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('❌ Error al conectar con el servidor');
                        boton.innerHTML = textoOriginal;
                        boton.disabled = false;
                    }
                });
            }
        });
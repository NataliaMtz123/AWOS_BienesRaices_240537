extends layout/index

block contenido
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center.text-blue-600 Bienes
            span.font-normal.text-black Raíces
        
        .max-w-md.mx-auto.bg-white.py-8.px-4.shadow-2xl.rounded-2xl
            h2.text-2xl.font-bold.text-center.text-gray-800 ¡Bienvenido!
            
            //- Foto de perfil
            .flex.justify-center.mt-6
                if usuario.fotoPerfil
                    - var fotoOriginal = usuario.fotoPerfil
                    - var fotoGoogleOptimizada = fotoOriginal.includes('googleusercontent') ? fotoOriginal.replace('s96-c', 's400-c') : fotoOriginal
                    
                    img#fotoPerfil.w-24.h-24.rounded-full.object-cover.border-4.border-blue-200(
                        src=fotoGoogleOptimizada,
                        alt=usuario.name,
                        onerror="this.onerror=null; this.src='" + fotoOriginal + "'; this.onerror=function(){ this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('" + usuario.name + "') + '&size=96&background=0D9488&color=fff&bold=true'; }"
                    )
                else
                    .w-24.h-24.rounded-full.bg-blue-100.flex.items-center.justify-center.border-4.border-blue-200
                        svg.w-12.h-12.text-blue-500(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")
            
            //- Datos del usuario
            .mt-6.space-y-4
                .bg-gray-50.p-4.rounded-lg
                    p.text-sm.text-gray-500 Nombre
                    p.text-lg.font-semibold.text-gray-800= usuario.name
                
                .bg-gray-50.p-4.rounded-lg
                    p.text-sm.text-gray-500 Email
                    p.text-lg.font-semibold.text-gray-800= usuario.email
                
                .bg-gray-50.p-4.rounded-lg
                    p.text-sm.text-gray-500 Proveedor
                    if usuario.proveedor
                        p.text-sm.font-semibold(class=usuario.proveedor === 'google' ? 'text-blue-600' : 'text-gray-800')= usuario.proveedor
                    else
                        p.text-sm.text-red-500 No especificado
            
            //- Botón de cerrar sesión
            .mt-8.text-center
                a.w-full.bg-red-500.hover-bg-red-600.text-white.font-bold.py-3.px-4.rounded-lg.shadow-lg.transition.block(href="/auth/logout")
                    | Cerrar Sesión

    //- Script para manejo de errores de imagen
    script.
        document.addEventListener('DOMContentLoaded', function() {
            const foto = document.getElementById('fotoPerfil');
            if (foto) {
                foto.addEventListener('error', function() {
                    console.log('Error cargando foto');
                    if (this.src.includes('s400-c')) {
                        this.src = this.src.replace('s400-c', 's96-c');
                    } else {
                        this.src = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&size=96&background=0D9488&color=fff&bold=true';
                    }
                });
            }
        });